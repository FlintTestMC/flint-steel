# Copy this file to .cargo/config.toml and adjust the sibling checkout paths.
# Cargo.toml enables Steel's test-harness feature; patches only select local sources.

[patch."https://github.com/kdcokenny/SteelMC.git"]
steel-core     = { path = "../SteelMC/steel-core" }
steel-registry = { path = "../SteelMC/steel-registry" }
steel-utils    = { path = "../SteelMC/steel-utils" }

[patch."https://github.com/kdcokenny/flint-core.git"]
flint-core = { path = "../flint-core" }
